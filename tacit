#!/usr/bin/env bash
set -euo pipefail

OWNER_REPO="lampepfl/tacit"
SCRIPT_SOURCE_URL="https://raw.githubusercontent.com/${OWNER_REPO}/refs/heads/main/tacit"
CACHE_DIR="${HOME}/.cache/tacit"
INSTALL_DIR="${HOME}/.local/bin"
INSTALL_PATH="${INSTALL_DIR}/tacit"
SERVER_JAR="${CACHE_DIR}/TACIT.jar"
LIBRARY_JAR="${CACHE_DIR}/TACIT-library.jar"
RELEASE_MARKER="${CACHE_DIR}/release.txt"
PATH_MARKER_BEGIN="# >>> tacit path >>>"
PATH_MARKER_END="# <<< tacit path <<<"

print_help() {
  cat <<EOF
TACIT command line wrapper

Usage:
  tacit help
  tacit setup
  tacit self update
  tacit self uninstall
  tacit update
  tacit serve [server-args...]

Commands:
  help     Show this help message.
  setup    Install tacit into ~/.local/bin, ensure PATH is configured,
           verify Java 17+, and download the latest TACIT release jars.
  self     Manage the tacit wrapper itself.
  update   Download the latest TACIT release jars into ~/.cache/tacit when
           the cached release is missing or out of date.
  serve    Run TACIT with the latest cached jars and forward extra args to
           the Java process.

Self commands:
  update    Download the latest tacit wrapper from GitHub and replace the
            current script when it has changed.
  uninstall Remove the installed tacit wrapper and delete cached TACIT jars.

Locations:
  Script install: ~/.local/bin/tacit
  Jar cache:      ~/.cache/tacit/

Examples:
  tacit setup
  tacit self update
  tacit self uninstall
  tacit update
  tacit serve --quiet
EOF
}

print_self_help() {
  cat <<EOF
TACIT self-management commands

Usage:
  tacit self update
  tacit self uninstall

Commands:
  update    Download the latest tacit wrapper from GitHub and replace the
            current script when it has changed.
  uninstall Remove the installed tacit wrapper and delete cached TACIT jars.
EOF
}

fail() {
  echo "Error: $*" >&2
  exit 1
}

require_command() {
  local name="$1"
  command -v "$name" >/dev/null 2>&1 || fail "$name is required but was not found."
}

java_major_version() {
  local version_line raw_version major

  version_line="$(java -version 2>&1 | head -n1 || true)"
  [[ -n "$version_line" ]] || return 1

  if [[ "$version_line" =~ \"([0-9]+)(\.([0-9]+))?([._][0-9]+)? ]]; then
    raw_version="${BASH_REMATCH[1]}"
    if [[ "$raw_version" == "1" && -n "${BASH_REMATCH[3]:-}" ]]; then
      major="${BASH_REMATCH[3]}"
    else
      major="$raw_version"
    fi
    printf '%s\n' "$major"
    return 0
  fi

  return 1
}

ensure_java() {
  local major

  if ! command -v java >/dev/null 2>&1; then
    fail "Java 17+ is required. Install Java and try again."
  fi

  if ! major="$(java_major_version)"; then
    fail "Unable to detect the installed Java version. Install Java 17+ and try again."
  fi

  if (( major < 17 )); then
    fail "Java 17+ is required. Found Java ${major}. Install a newer Java version and try again."
  fi
}

ensure_cache_dir() {
  mkdir -p "$CACHE_DIR"
}

release_json() {
  local api_url="https://api.github.com/repos/${OWNER_REPO}/releases/latest"
  local curl_args=(-sSL -H "Accept: application/vnd.github+json")
  local response http_code body

  require_command curl

  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    curl_args+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
  fi

  response="$(curl "${curl_args[@]}" -w $'\n%{http_code}' "$api_url")" \
    || fail "failed to query the GitHub API at ${api_url}."
  http_code="${response##*$'\n'}"
  body="${response%$'\n'*}"

  case "$http_code" in
    2*) ;;
    403)
      fail "GitHub API returned 403 Forbidden for ${api_url}. You may be rate limited; set GITHUB_TOKEN to raise the rate limit."
      ;;
    *)
      fail "GitHub API returned HTTP ${http_code} for ${api_url}."
      ;;
  esac

  printf '%s\n' "$body"
}

extract_release_field() {
  local json="$1"
  local field="$2"

  printf '%s' "$json" | grep -m1 -oE "\"${field}\"[[:space:]]*:[[:space:]]*\"[^\"]+\"" | sed -E 's/^[^"]*"[^"]*"[[:space:]]*:[[:space:]]*"([^"]+)"$/\1/'
}

extract_release_id() {
  local json="$1"

  printf '%s' "$json" | grep -m1 -oE '"id"[[:space:]]*:[[:space:]]*[0-9]+' | sed -E 's/.*:[[:space:]]*//'
}

extract_assets() {
  local json="$1"

  # Prefer jq when available: it parses JSON structurally and does not depend
  # on field order within asset objects. Fall back to the grep state machine.
  if command -v jq >/dev/null 2>&1; then
    extract_assets_jq "$json"
  else
    extract_assets_grep "$json"
  fi
}

extract_assets_jq() {
  local json="$1"
  local parsed

  if ! parsed="$(printf '%s' "$json" | jq -r '
    [ .assets[]?
      | select(.name == "TACIT.jar" or .name == "TACIT-library.jar")
      | "\(.name)\t\(.browser_download_url)\t\(.digest // "")"
    ] | unique | .[]
  ' 2>/dev/null)"; then
    fail "failed to parse the latest release metadata with jq."
  fi

  printf '%s\n' "$parsed" | grep -qF $'TACIT.jar\t' \
    || fail "required asset TACIT.jar not found in the latest release."
  printf '%s\n' "$parsed" | grep -qF $'TACIT-library.jar\t' \
    || fail "required asset TACIT-library.jar not found in the latest release."

  printf '%s\n' "$parsed"
}

extract_assets_grep() {
  local json="$1"
  local library_url="" library_digest=""
  local assembly_url="" assembly_digest=""
  local current_name="" current_digest=""
  local url=""

  while IFS= read -r token; do
    if [[ "$token" =~ \"name\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      current_name="${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "$token" =~ \"digest\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      current_digest="${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "$token" =~ \"browser_download_url\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      url="${BASH_REMATCH[1]}"

      if [[ "$current_name" == "TACIT-library.jar" ]]; then
        library_url="$url"
        library_digest="$current_digest"
      fi

      if [[ "$current_name" == "TACIT.jar" ]]; then
        assembly_url="$url"
        assembly_digest="$current_digest"
      fi

      current_name=""
      current_digest=""
    fi
  done < <(printf '%s' "$json" | grep -oE '"name"[[:space:]]*:[[:space:]]*"[^"]+"|"digest"[[:space:]]*:[[:space:]]*"[^"]+"|"browser_download_url"[[:space:]]*:[[:space:]]*"[^"]+"')

  [[ -n "$assembly_url" ]] || fail "required asset TACIT.jar not found in the latest release."
  [[ -n "$library_url" ]] || fail "required asset TACIT-library.jar not found in the latest release."

  printf 'TACIT.jar\t%s\t%s\nTACIT-library.jar\t%s\t%s\n' \
    "$assembly_url" "$assembly_digest" \
    "$library_url" "$library_digest"
}

release_key_from_json() {
  local json="$1"
  local release_id tag_name

  release_id="$(extract_release_id "$json")"
  tag_name="$(extract_release_field "$json" "tag_name")"
  [[ -n "$release_id" && -n "$tag_name" ]] || fail "failed to parse the latest release metadata."
  printf '%s|%s\n' "$release_id" "$tag_name"
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    return 1
  fi
}

verify_jar() {
  local file="$1" digest="$2"
  local name expected actual

  name="$(basename "$file")"

  # Fail closed: a matched TACIT asset without a digest is exactly the
  # tamper/corruption case we must not install.
  if [[ -z "$digest" ]]; then
    fail "no digest in release metadata for ${name}; refusing to install an unverified jar."
  fi

  # digest format is "sha256:<64 hex chars>"
  if [[ "$digest" =~ ^sha256:([0-9a-fA-F]{64})$ ]]; then
    expected="${BASH_REMATCH[1]}"
  else
    fail "unrecognised digest format '${digest}' for ${name}; expected 'sha256:' followed by 64 hex characters."
  fi

  if ! actual="$(sha256_of "$file")"; then
    fail "cannot verify ${name}: no sha256 tool found. Install coreutils (sha256sum) or use macOS shasum."
  fi

  if [[ "$actual" != "$expected" ]]; then
    fail "Checksum mismatch for ${name}: expected ${expected}, got ${actual}"
  fi
  echo "  ${name}: verified (sha256)"
}

cached_release_matches() {
  local release_key="$1"

  [[ -f "$SERVER_JAR" && -f "$LIBRARY_JAR" && -f "$RELEASE_MARKER" ]] || return 1
  [[ "$(cat "$RELEASE_MARKER")" == "$release_key" ]]
}

# Re-verify cached jars against the release digests before trusting them.
# Returns 0 when the cache is trustworthy, 1 when it must be re-downloaded.
# When digests are unavailable (or no sha256 tool exists), keep the old
# behavior and trust the cache: this check must not add new failure modes.
cached_jars_match_digests() {
  local assets_info="$1"
  local name _url digest expected actual

  while IFS=$'\t' read -r name _url digest; do
    [[ -n "$name" ]] || continue
    # No digest in metadata: cannot do better than the old behavior.
    [[ -n "$digest" ]] || return 0
    if [[ "$digest" =~ ^sha256:([0-9a-fA-F]{64})$ ]]; then
      expected="${BASH_REMATCH[1]}"
    else
      # Unusable digest format: treat the cache as stale and re-download.
      return 1
    fi
    # No sha256 tool available: keep the old behavior and trust the cache.
    actual="$(sha256_of "${CACHE_DIR}/${name}")" || return 0
    [[ "$actual" == "$expected" ]] || return 1
  done <<< "$assets_info"

  return 0
}

download_latest_release() {
  local json release_key tmp_dir
  local name url

  ensure_cache_dir
  json="$(release_json)"
  release_key="$(release_key_from_json "$json")"

  if cached_release_matches "$release_key"; then
    local cached_assets_info
    cached_assets_info="$(extract_assets "$json")"
    if cached_jars_match_digests "$cached_assets_info"; then
      echo "TACIT is already up to date in ${CACHE_DIR}."
      return 0
    fi
    echo "Cached TACIT jars failed checksum verification; downloading again."
  fi

  tmp_dir="$(mktemp -d "${CACHE_DIR}/download.XXXXXX")"
  trap 'rm -rf "$tmp_dir"' EXIT

  local assets_info
  assets_info="$(extract_assets "$json")"

  echo "Downloading the latest TACIT release to ${CACHE_DIR}"
  while IFS=$'\t' read -r name url _digest; do
    [[ -n "$name" && -n "$url" ]] || continue
    echo "- ${name}"
    curl -fL "$url" -o "${tmp_dir}/${name}"
  done <<< "$assets_info"

  echo "Verifying checksums..."
  while IFS=$'\t' read -r name _url digest; do
    [[ -n "$name" && -f "${tmp_dir}/${name}" ]] || continue
    verify_jar "${tmp_dir}/${name}" "$digest"
  done <<< "$assets_info"

  mv "${tmp_dir}/TACIT.jar" "$SERVER_JAR"
  mv "${tmp_dir}/TACIT-library.jar" "$LIBRARY_JAR"
  printf '%s\n' "$release_key" > "$RELEASE_MARKER"

  trap - EXIT
  rmdir "$tmp_dir" 2>/dev/null || true

  echo "Latest TACIT release is ready:"
  echo "- ${SERVER_JAR}"
  echo "- ${LIBRARY_JAR}"
}

profile_candidates() {
  local shell_name

  shell_name="$(basename "${SHELL:-}")"
  case "$shell_name" in
    zsh)
      printf '%s\n' "${HOME}/.zshrc" "${HOME}/.zprofile"
      ;;
    bash)
      printf '%s\n' "${HOME}/.bashrc" "${HOME}/.bash_profile" "${HOME}/.profile"
      ;;
    *)
      printf '%s\n' "${HOME}/.profile"
      ;;
  esac
}

path_snippet() {
  cat <<EOF
${PATH_MARKER_BEGIN}
case ":\$PATH:" in
  *":\$HOME/.local/bin:"*) ;;
  *) export PATH="\$HOME/.local/bin:\$PATH" ;;
esac
${PATH_MARKER_END}
EOF
}

update_profile_path() {
  local updated_any=false
  local file content snippet

  snippet="$(path_snippet)"

  while IFS= read -r file; do
    [[ -n "$file" && -f "$file" ]] || continue
    content="$(cat "$file")"
    if [[ "$content" == *"$PATH_MARKER_BEGIN"* ]] || [[ "$content" == *'$HOME/.local/bin'* ]] || [[ "$content" == *"${HOME}/.local/bin"* ]]; then
      continue
    fi

    {
      printf '\n'
      printf '%s\n' "$snippet"
    } >> "$file"
    echo "Updated ${file} to include ~/.local/bin in PATH."
    updated_any=true
  done < <(profile_candidates)

  if [[ ":$PATH:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
  fi

  if [[ "$updated_any" == true ]]; then
    echo "Open a new shell or source your profile to pick up PATH changes."
  else
    echo "~/.local/bin is already configured in PATH profiles."
  fi
}

self_path() {
  printf '%s\n' "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"
}

install_self() {
  local source_path

  source_path="$(self_path)"
  mkdir -p "$INSTALL_DIR"
  cp "$source_path" "$INSTALL_PATH"
  chmod +x "$INSTALL_PATH"
  echo "Installed tacit to ${INSTALL_PATH}"
}

download_latest_self() {
  local output_path="$1"
  local curl_args=(-fsSL)

  require_command curl

  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    curl_args+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
  fi

  curl "${curl_args[@]}" -o "$output_path" "$SCRIPT_SOURCE_URL"
}

require_cached_jars() {
  [[ -f "$SERVER_JAR" && -f "$LIBRARY_JAR" ]] || fail "No cached TACIT jars were found. Run 'tacit setup' (first time) or 'tacit update'."
}

cmd_setup() {
  ensure_java
  install_self
  update_profile_path
  download_latest_release
}

cmd_update() {
  download_latest_release
}

cmd_self_update() {
  local source_path source_dir tmp_path

  source_path="$(self_path)"
  [[ -f "$source_path" ]] || fail "Current tacit script was not found at ${source_path}."

  source_dir="$(dirname "$source_path")"
  tmp_path="$(mktemp "${source_dir}/tacit.self-update.XXXXXX")" || fail "Unable to create a temporary file in ${source_dir}."

  echo "Checking ${SCRIPT_SOURCE_URL}"
  if ! download_latest_self "$tmp_path"; then
    rm -f "$tmp_path"
    fail "Failed to download the latest tacit wrapper."
  fi

  if ! "$BASH" -n "$tmp_path"; then
    rm -f "$tmp_path"
    fail "Downloaded tacit wrapper is not a valid Bash script."
  fi

  if cmp -s "$source_path" "$tmp_path"; then
    rm -f "$tmp_path"
    echo "tacit is already up to date at ${source_path}."
    return 0
  fi

  chmod +x "$tmp_path"
  if ! mv "$tmp_path" "$source_path"; then
    rm -f "$tmp_path"
    fail "Unable to replace ${source_path}. Check file permissions and try again."
  fi

  echo "Updated tacit at ${source_path}"
}

remove_profile_path() {
  local file content cleaned

  while IFS= read -r file; do
    [[ -n "$file" && -f "$file" ]] || continue
    content="$(cat "$file")"
    [[ "$content" == *"$PATH_MARKER_BEGIN"* ]] || continue

    if [[ "$content" != *"$PATH_MARKER_END"* ]]; then
      echo "Warning: ${file} contains the tacit begin marker but no end marker; leaving it untouched." >&2
      continue
    fi

    cleaned="$(awk -v begin="$PATH_MARKER_BEGIN" -v end="$PATH_MARKER_END" '
      index($0, begin) { skip=1; next }
      index($0, end)   { skip=0; next }
      !skip
    ' "$file")"

    # Remove trailing blank lines left behind
    cleaned="$(printf '%s\n' "$cleaned" | awk '
      { lines[NR] = $0 }
      END {
        last = NR
        while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
        for (i = 1; i <= last; i++) print lines[i]
      }
    ')"

    printf '%s\n' "$cleaned" > "$file"
    echo "Cleaned PATH snippet from ${file}"
  done < <(profile_candidates)
}

cmd_uninstall() {
  if [[ -f "$INSTALL_PATH" ]]; then
    rm -f "$INSTALL_PATH"
    echo "Removed ${INSTALL_PATH}"
  else
    echo "No installed tacit wrapper was found at ${INSTALL_PATH}."
  fi

  if [[ -d "$CACHE_DIR" ]]; then
    rm -rf "$CACHE_DIR"
    echo "Removed ${CACHE_DIR}"
  else
    echo "No TACIT cache directory was found at ${CACHE_DIR}."
  fi

  remove_profile_path
}

cmd_serve() {
  ensure_java
  require_cached_jars
  exec java -jar "$SERVER_JAR" --library-jar "$LIBRARY_JAR" "$@"
}

main() {
  local command="${1:-help}"
  local subcommand

  case "$command" in
    help|-h|--help)
      print_help
      ;;
    setup)
      shift
      [[ $# -eq 0 ]] || fail "setup does not accept additional arguments."
      cmd_setup
      ;;
    uninstall)
      fail "The 'uninstall' command has moved to 'tacit self uninstall'."
      ;;
    self)
      shift
      subcommand="${1:-help}"
      case "$subcommand" in
        help|-h|--help)
          [[ $# -le 1 ]] || fail "self help does not accept additional arguments."
          print_self_help
          ;;
        update)
          shift
          [[ $# -eq 0 ]] || fail "self update does not accept additional arguments."
          cmd_self_update
          ;;
        uninstall)
          shift
          [[ $# -eq 0 ]] || fail "self uninstall does not accept additional arguments."
          cmd_uninstall
          ;;
        *)
          fail "Unknown self command: ${subcommand}"
          ;;
      esac
      ;;
    update)
      shift
      [[ $# -eq 0 ]] || fail "update does not accept additional arguments."
      cmd_update
      ;;
    serve)
      shift
      cmd_serve "$@"
      ;;
    *)
      echo "Unknown command: ${command}" >&2
      echo >&2
      print_help >&2
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
